async def run_channel_job(channel: Dict, mode: str) -> None:
    tokens_dir = Path(GLOBAL_CONFIG["TOKENS_DIR"])
    tokens_dir.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    work_dir = Path(GLOBAL_CONFIG["BASE_OUTPUT_DIR"]) / channel["id"] / f"{mode}_{ts}"
    work_dir.mkdir(parents=True, exist_ok=True)

    is_vertical = mode == "shorts"
    print(f"\n🚀 [{mode.upper()}] إنتاج فيديو لقناة: {channel['name']} ({channel['id']})")

    metadata = generate_short_script(channel) if is_vertical else generate_long_form_script(channel)
    print(f"   📝 العنوان: {metadata['title']}")

    audio_path = work_dir / "voice.mp3"
    srt_path = work_dir / "captions.srt"
    await create_voice_track_and_subtitles(metadata, channel, audio_path, srt_path)

    orientation = "portrait" if is_vertical else "landscape"
    clips: List[Path] = []
    headers = {"Authorization": GLOBAL_CONFIG["PEXELS_API_KEY"]}
    target_h = 1920 if orientation == "portrait" else 1080
    for idx, q in enumerate(metadata["search_queries"]):
        try:
            r = requests.get(
                "https://api.pexels.com/videos/search",
                headers=headers,
                params={"query": q, "orientation": orientation, "size": "medium", "per_page": 3},
                timeout=20,
            )
            vids = r.json().get("videos", [])
            if vids:
                vfiles = [f for f in vids[0].get("video_files", []) if f.get("file_type") == "video/mp4"]
                if vfiles:
                    vfiles.sort(key=lambda x: abs((x.get("height") or 0) - target_h))
                    cp = work_dir / f"clip_{idx}.mp4"
                    urllib.request.urlretrieve(vfiles[0]["link"], cp)
                    clips.append(cp)
        except Exception:
            pass

    if not clips:
        raise RuntimeError("تعذر جلب المشاهد من Pexels.")

    thumb_path = work_dir / "custom_thumbnail.jpg"
    create_scroll_stopping_thumbnail(
        clips[0],
        metadata.get("thumbnail_hook", metadata["title"][:25]),
        thumb_path,
        is_vertical=is_vertical,
        is_kids=channel["is_kids"],
    )

    final_video = work_dir / f"{channel['id']}_{mode}.mp4"
    render_complete_video(
        clips,
        audio_path,
        srt_path,
        final_video,
        work_dir,
        is_vertical=is_vertical,
        is_cocomelon=channel.get("is_cocomelon_music", False),
        poster_thumb_path=thumb_path,
    )

    upload_to_youtube_with_thumbnail(final_video, thumb_path, metadata, channel, tokens_dir)
    if is_vertical:
        publish_to_tiktok(final_video, metadata, channel, tokens_dir)


async def execute_filtered_channels(niche_num: Optional[int], mode: str) -> None:
    targets = [
        ch for ch in CHANNELS_22_MATRIX if (niche_num is None or ch["niche_num"] == niche_num)
    ]
    for ch in targets:
        try:
            await run_channel_job(ch, mode=mode)
        except Exception as exc:
            print(f"⚠️ خطأ في {ch['id']} ({mode}): {exc}")


def authenticate_all_22_channels_once() -> None:
    tokens_dir = Path(GLOBAL_CONFIG["TOKENS_DIR"])
    tokens_dir.mkdir(parents=True, exist_ok=True)
    secrets_file = tokens_dir / "client_secrets.json"
    if not secrets_file.exists():
        print(f"يرجى وضع ملف {secrets_file} أولاً.")
        return

    from google_auth_oauthlib.flow import InstalledAppFlow

    for ch in CHANNELS_22_MATRIX:
        tfile = tokens_dir / f"yt_token_{ch['id']}.json"
        if tfile.exists():
            print(f"✔️ القناة {ch['name']} جاهزة ({tfile.name}).")
            continue
        input(f"اضغط Enter لتسجيل الدخول إلى قناة [{ch['name']}]...")
        flow = InstalledAppFlow.from_client_secrets_file(str(secrets_file), YOUTUBE_SCOPES)
        creds = flow.run_local_server(port=0)
        tfile.write_text(creds.to_json(), encoding="utf-8")
        print(f"✅ تم الحفظ! انسخ محتوى {tfile.name} إلى GitHub Secret باسم YT_TOKEN_{ch['secret_suffix']}")


