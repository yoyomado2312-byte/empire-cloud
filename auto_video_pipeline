# 3. محرك Suno الذكي مع التبديل التلقائي بين الحسابات عند انتهاء الرصيد
# ==============================================================================
class SunoAccountRotator:
    """
    يدير مجموعة من حسابات Suno المجانية (Tokens / Session Cookies).
    عند انتهاء الرصيد اليومي (Daily Limit) في حساب، ينتقل تلقائياً للحساب التالي
    لتوليد الأغاني دون توقف النظام.
    """

    def __init__(self, tokens: List[str]):
        self.tokens = tokens
        self.current_idx = 0

    def get_active_token(self) -> Optional[str]:
        if not self.tokens:
            return None
        return self.tokens[self.current_idx % len(self.tokens)]

    def rotate_to_next(self) -> Optional[str]:
        if not self.tokens:
            return None
        self.current_idx += 1
        print(
            f"🔄 [Suno Rotator] تم التبديل للحساب رقم {self.current_idx + 1} لتفادي حد الاستخدام..."
        )
        return self.get_active_token()

    def generate_cocomelon_song(
        self, lyrics: str, title: str, dest_audio_path: Path, language: str = "en"
    ) -> bool:
        style_prompt = (
            "Upbeat joyful nursery rhyme, CoComelon style, cheerful female toddler vocals, acoustic guitar, bouncy catchy melody, 4k audio"
            if language == "en"
            else "أنشودة أطفال كرتونية مرحة، أسلوب كوكوميلون، صوت طفولي مبهج، ألحان سعيدة وواضحة جداً للأطفال"
        )

        attempts = max(1, len(self.tokens))
        for _ in range(attempts):
            token = self.get_active_token()
            if not token:
                break

            headers = {
                "Authorization": f"Bearer {token}",
                "Content-Type": "application/json",
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
            }
            payload = {
                "prompt": lyrics[:800],
                "tags": style_prompt,
                "title": title[:70],
                "make_instrumental": False,
                "mv": "chirp-v3-5",
            }

            try:
                # محاولة الاتصال بنقطة توليد الأغاني في Suno
                resp = requests.post(
                    "https://studio-api.prod.suno.com/api/generate/v2-web/",
                    headers=headers,
                    json=payload,
                    timeout=30,
                )
                if resp.status_code in (401, 402, 429):
                    print(f"⚠️ [Suno Limit] الحساب الحالي وصل للحد الأقصى أو منتهي الصلاحية.")
                    self.rotate_to_next()
                    continue

                resp.raise_for_status()
                clips = resp.json().get("clips", [])
                if not clips:
                    self.rotate_to_next()
                    continue

                clip_id = clips[0]["id"]
                print(f"   🎵 جاري تلحين وغناء الأنشودة عبر Suno (معرف: {clip_id})...")

                # الاستعلام المتكرر حتى اكتمال الأغنية
                for _ in range(25):
                    time.sleep(6)
                    feed_resp = requests.get(
                        f"https://studio-api.prod.suno.com/api/feed/?ids={clip_id}",
                        headers=headers,
                        timeout=20,
                    )
                    if feed_resp.ok:
                        data = feed_resp.json()
                        item = data[0] if isinstance(data, list) and data else None
                        if item and item.get("audio_url"):
                            audio_url = item["audio_url"]
                            urllib.request.urlretrieve(audio_url, dest_audio_path)
                            print(f"   ✅ تم استخراج الأغنية بنجاح من Suno وحفظها في {dest_audio_path.name}")
                            return True

            except Exception as exc:
                print(f"   [تنبيه Suno]: {exc}")
                self.rotate_to_next()

        print("ℹ️ لم يتم الاتصال بحساب Suno؛ سيتم استخدام المحرك الصوتي الغنائي البديل تلقائياً.")
        return False


