        success = SUNO_ROTATOR.generate_cocomelon_song(
            lyrics=lyrics_text,
            title=metadata["title"],
            dest_audio_path=audio_path,
            language=channel["language"],
        )
        if success:
            # توليد ملف الترجمة المتزامن للأغنية
            await generate_srt_from_text(lyrics_text, channel, srt_path)
            return

    # المحرك الصوتي الأساسي (أو البديل في حال عدم توفر Suno)
    communicate = edge_tts.Communicate(
        text=metadata["script"],
        voice=channel["voice"],
        rate=channel["voice_rate"],
    )
    submaker = edge_tts.SubMaker()
    with open(audio_path, "wb") as af:
        async for chunk in communicate.stream():
            if chunk["type"] == "audio":
                af.write(chunk["data"])
            elif chunk["type"] == "WordBoundary":
                submaker.feed(chunk)
    with open(srt_path, "w", encoding="utf-8") as sf:
        sf.write(submaker.get_srt())


async def generate_srt_from_text(text: str, channel: Dict, srt_path: Path) -> None:
    dummy_audio = srt_path.parent / "temp_dummy.mp3"
    comm = edge_tts.Communicate(text=text, voice=channel["voice"], rate=channel["voice_rate"])
    submaker = edge_tts.SubMaker()
    with open(dummy_audio, "wb") as af:
        async for chunk in comm.stream():
            if chunk["type"] == "audio":
                af.write(chunk["data"])
            elif chunk["type"] == "WordBoundary":
                submaker.feed(chunk)
    with open(srt_path, "w", encoding="utf-8") as sf:
        sf.write(submaker.get_srt())
    if dummy_audio.exists():
        dummy_audio.unlink()


def create_scroll_stopping_thumbnail(
    video_clip_path: Path,
    hook_text: str,
    output_thumb_path: Path,
    is_vertical: bool = False,
    is_kids: bool = False,
) -> Path:
    w, h = (1080, 1920) if is_vertical else (1280, 720)
    raw_frame_path = output_thumb_path.parent / "raw_frame.jpg"

    subprocess.run(
        [
            "ffmpeg", "-y",
            "-ss", "00:00:01.00",
            "-i", str(video_clip_path),
            "-frames:v", "1",
            "-vf", f"scale={w}:{h}:force_original_aspect_ratio=increase,crop={w}:{h}",
            str(raw_frame_path),
        ],
        check=True,
    )

    img = Image.open(raw_frame_path).convert("RGB")
    img = ImageEnhance.Contrast(img).enhance(1.28)
    img = ImageEnhance.Color(img).enhance(1.35)

    draw = ImageDraw.Draw(img, "RGBA")
    b_top = int(h * 0.62) if is_vertical else int(h * 0.58)
    b_bottom = int(h * 0.82) if is_vertical else int(h * 0.88)

    # إطار كرتوني باللون الوردي المبهج للأطفال أو الذهبي للمجالات الأخرى
    border_color = (255, 105, 180, 255) if is_kids else (255, 215, 0, 255)
    draw.rectangle([(0, 0), (w - 1, h - 1)], outline=border_color, width=14)

    draw.rectangle([(40, b_top), (w - 40, b_bottom)], fill=(15, 15, 25, 225))
    draw.rectangle([(40, b_top), (w - 40, b_top + 16)], fill=(255, 69, 0, 255))

    font_sz = 68 if is_vertical else 64
    font = None
    for candidate in [
        "/usr/share/fonts/truetype/noto/NotoSansArabic-Bold.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    ]:
        if Path(candidate).exists():
            font = ImageFont.truetype(candidate, font_sz)
            break
    if font is None:
        font = ImageFont.load_default()

    tbox = draw.textbbox((0, 0), hook_text, font=font)
    tw, th = tbox[2] - tbox[0], tbox[3] - tbox[1]
    tx = max(60, (w - tw) // 2)
    ty = b_top + ((b_bottom - b_top - th) // 2)

    draw.text((tx + 4, ty + 4), hook_text, font=font, fill=(0, 0, 0, 255))
    text_color = (255, 255, 0, 255) if not is_kids else (0, 255, 255, 255)
    draw.text((tx, ty), hook_text, font=font, fill=text_color)

    img.save(output_thumb_path, "JPEG", quality=92)
    return output_thumb_path


def render_complete_video(
    clips: List[Path],
    audio_path: Path,
    srt_path: Path,
    final_path: Path,
    work_dir: Path,
    is_vertical: bool = True,
    is_cocomelon: bool = False,
    poster_thumb_path: Optional[Path] = None,
) -> Path:
    total_dur = float(
        subprocess.run(
            [
                "ffprobe", "-v", "error", "-show_entries", "format=duration",
                "-of", "default=noprint_wrappers=1:nokey=1", str(audio_path),
            ],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    )

    cut_sec = (
        GLOBAL_CONFIG["SHORT_CLIP_SWITCH_SEC"]
        if is_vertical
        else GLOBAL_CONFIG["LONG_CLIP_SWITCH_SEC"]
    )
    w, h = (1080, 1920) if is_vertical else (1920, 1080)
    needed = max(1, int(total_dur // cut_sec) + 1)

    segments: List[Path] = []
    if is_vertical and poster_thumb_path and poster_thumb_path.exists():
        intro_seg = work_dir / "seg_intro_poster.mp4"
        subprocess.run(
            [
                "ffmpeg", "-y", "-loop", "1", "-i", str(poster_thumb_path),
                "-t", "0.40", "-vf", f"scale={w}:{h},fps=30,format=yuv420p",
                "-c:v", "libx264", "-preset", "fast", str(intro_seg),
            ],
            check=True,
        )
        segments.append(intro_seg)

    for i in range(needed):
        src = clips[i % len(clips)]
        seg_out = work_dir / f"seg_{i}.mp4"
        vf = (
            f"scale={int(w*1.05)}:{int(h*1.05)}:force_original_aspect_ratio=increase,"
            f"crop={w}:{h},fps=30,eq=contrast=1.06:saturation=1.14,format=yuv420p"
        )
        subprocess.run(
            [
                "ffmpeg", "-y", "-stream_loop", "-1", "-i", str(src),
                "-t", f"{cut_sec:.2f}", "-vf", vf, "-an",
                "-c:v", "libx264", "-preset", "fast", str(seg_out),
            ],
            check=True,
        )
        segments.append(seg_out)

    concat_txt = work_dir / "concat.txt"
    with open(concat_txt, "w", encoding="utf-8") as f:
        for s in segments:
            f.write(f"file '{s.resolve()}'\n")

    merged_v = work_dir / "merged_v.mp4"
    subprocess.run(
        ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(concat_txt), "-c", "copy", str(merged_v)],
        check=True,
    )

    escaped_srt = str(srt_path.resolve()).replace("\\", "/").replace(":", "\\:")
    # ستايل الكلمات الغنائية الكرتونية المضيئة CoComelon Sing-Along
    if is_cocomelon:
        style = (
            "FontName=Arial,FontSize=24,Bold=1,PrimaryColour=&H0000FFFF,"
            "OutlineColour=&H00FF00FF,BorderStyle=3,Outline=4,Shadow=1,Alignment=2,MarginV=80"
        )
    else:
        margin_v = 75 if is_vertical else 40
        font_sz = 20 if is_vertical else 18
        style = (
            f"FontName=Arial,FontSize={font_sz},Bold=1,PrimaryColour=&H0000FFFF,"
            f"OutlineColour=&H00000000,BorderStyle=3,Outline=2,Shadow=1,Alignment=2,MarginV={margin_v}"
        )

    subprocess.run(
        [
            "ffmpeg", "-y",
            "-i", str(merged_v),
            "-i", str(audio_path),
            "-t", f"{total_dur:.2f}",
            "-vf", f"subtitles='{escaped_srt}':force_style='{style}'",
            "-map", "0:v:0", "-map", "1:a:0",
            "-c:v", "libx264", "-preset", "fast",
            "-c:a", "aac", "-b:a", "192k",
            str(final_path),
        ],
        check=True,
    )
    return final_path


