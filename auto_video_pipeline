YOUTUBE_SCOPES = [
    "https://www.googleapis.com/auth/youtube.upload",
    "https://www.googleapis.com/auth/youtube.force-ssl",
]


def load_yt_credentials(channel: Dict, tokens_dir: Path):
    from google.auth.transport.requests import Request
    from google.oauth2.credentials import Credentials
    from google_auth_oauthlib.flow import InstalledAppFlow

    secret_val = os.getenv(f"YT_TOKEN_{channel['secret_suffix']}", "").strip()
    token_file = tokens_dir / f"yt_token_{channel['id']}.json"
    secrets_file = tokens_dir / "client_secrets.json"

    creds = None
    if secret_val:
        # يدعم لصق الـ Refresh Token الخام مباشرة من متصفح Google OAuth Playground أو ملف JSON
        if secret_val.startswith("{"):
            creds = Credentials.from_authorized_user_info(json.loads(secret_val), YOUTUBE_SCOPES)
        else:
            creds = Credentials(
                token=None,
                refresh_token=secret_val,
                token_uri="https://oauth2.googleapis.com/token",
                client_id=os.getenv("YT_CLIENT_ID", "").strip(),
                client_secret=os.getenv("YT_CLIENT_SECRET", "").strip(),
                scopes=YOUTUBE_SCOPES,
            )
    elif token_file.exists():
        creds = Credentials.from_authorized_user_file(str(token_file), YOUTUBE_SCOPES)

    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
            if not secret_val:
                token_file.write_text(creds.to_json(), encoding="utf-8")
        elif secrets_file.exists() and not os.getenv("GITHUB_ACTIONS"):
            flow = InstalledAppFlow.from_client_secrets_file(str(secrets_file), YOUTUBE_SCOPES)
            creds = flow.run_local_server(port=0)
            token_file.write_text(creds.to_json(), encoding="utf-8")
        else:
            return None
    return creds


def upload_to_youtube_with_thumbnail(
    video_path: Path, thumb_path: Path, metadata: Dict, channel: Dict, tokens_dir: Path
) -> Optional[str]:
    from googleapiclient.discovery import build
    from googleapiclient.http import MediaFileUpload

    creds = load_yt_credentials(channel, tokens_dir)
    if not creds:
        print(f"   [YouTube - {channel['id']}] بانتظار توكن القناة YT_TOKEN_{channel['secret_suffix']}.")
        return None

    youtube = build("youtube", "v3", credentials=creds)
    desc = (
        f"{metadata['title']}\n\n"
        f"🔥 {channel['affiliate_cta']}\n{channel['affiliate_url']}\n\n"
        + " ".join(f"#{t}" for t in metadata.get("tags", ["viral"]))
    )

    body = {
        "snippet": {
            "title": metadata["title"][:100],
            "description": desc[:4900],
            "tags": metadata.get("tags", ["viral"]),
            "categoryId": channel["youtube_category_id"],
        },
        "status": {"privacyStatus": "public", "selfDeclaredMadeForKids": channel["is_kids"]},
    }

    media = MediaFileUpload(str(video_path), chunksize=512 * 1024, resumable=True)
    req = youtube.videos().insert(part="snippet,status", body=body, media_body=media)
    resp = None
    while resp is None:
        _, resp = req.next_chunk()

    vid_id = resp.get("id")
    print(f"   ✅ [YouTube - {channel['name']}] تم نشر الفيديو: https://youtu.be/{vid_id}")

    if vid_id and thumb_path.exists():
        try:
            youtube.thumbnails().set(
                videoId=vid_id, media_body=MediaFileUpload(str(thumb_path), mimetype="image/jpeg")
            ).execute()
            print(f"   🖼️ تم تركيب الصورة المصغرة الخاطفة تلقائياً على {vid_id}")
        except Exception as exc:
            print(f"   [ملاحظة الصورة المصغرة]: {exc}")

    if vid_id and not channel["is_kids"]:
        try:
            c_text = (
                f"💬 {metadata.get('engagement_question', '')}\n\n"
                f"🔗 {channel['affiliate_cta']}\n{channel['affiliate_url']}"
            )
            youtube.commentThreads().insert(
                part="snippet",
                body={"snippet": {"videoId": vid_id, "topLevelComment": {"snippet": {"textOriginal": c_text}}}},
            ).execute()
        except Exception as exc:
            print(f"   [ملاحظة التعليق]: {exc}")

    return vid_id


def publish_to_tiktok(video_path: Path, metadata: Dict, channel: Dict, tokens_dir: Path) -> bool:
    suffix = channel["secret_suffix"]
    cookie_file = tokens_dir / f"tiktok_cookies_{channel['id']}.txt"
    secret_cookies = os.getenv(f"TIKTOK_COOKIES_{suffix}", "").strip()
    if secret_cookies and not cookie_file.exists():
        cookie_file.write_text(secret_cookies, encoding="utf-8")

    if cookie_file.exists():
        from tiktok_uploader.upload import upload_video

        caption = f"{metadata['title']} " + " ".join(f"#{t}" for t in metadata.get("tags", ["fyp"]))
        upload_video(
            filename=str(video_path), description=caption[:150], cookies=str(cookie_file), headless=True
        )
        print(f"   ✅ [TikTok - {channel['name']}] تم النشر بنجاح!")
        return True
    return False


